# ============================================================================
#  Droidspaces kernel requirements  --  non-GKI (Linux 4.19)
#  Device : Xiaomi Redmi 12C / Poco C55  ("earth", MT6768)
#  Base   : LineageOS android_kernel_xiaomi_earth, branch lineage-21
#  Source : https://github.com/ravindu644/Droidspaces-OSS
#           Documentation/Kernel-Configuration.md (non-GKI section)
#
#  NOTE: on non-GKI (3.18 - 4.19) these options are safe as-is. The kABI
#  padding patches are ONLY needed for GKI 5.4+ and must NOT be used here.
#
#  This file is merged on top of earth_defconfig with merge_config.sh.
# ============================================================================

# ---- IPC mechanisms --------------------------------------------------------
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# ---- Core namespace support ------------------------------------------------
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y

# ---- Seccomp ---------------------------------------------------------------
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ---- Control groups --------------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y

# ---- Resource limits: --memory, --cpus, --pids-limit -----------------------
# Safe on non-GKI because there is no vendor kABI to preserve.
CONFIG_MEMCG=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y

# ---- Device filesystem -----------------------------------------------------
CONFIG_DEVTMPFS=y

# ---- OverlayFS (required for volatile mode) --------------------------------
CONFIG_OVERLAY_FS=y

# ---- tmpfs xattr / posix acl (NixOS support) -------------------------------
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# ---- Firmware loading ------------------------------------------------------
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
# NOTE: CONFIG_FW_LOADER_COMPRESS does not exist in Linux 4.19 (it appeared in
# 5.x), so it is deliberately not listed here.

# ---- Sparse-image containers: loop device + ext4 ---------------------------
# Both are already =y on earth (selected by ANDROID_DEFAULT_SETTING / MACH_MT6768),
# but Droidspaces' own requirements check probes for them, so ask explicitly.
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y

# ---- Network isolation: NAT / none modes -----------------------------------
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
# NF_NAT and NF_NAT_REDIRECT are hidden in 4.19; they are selected by the
# family-specific options below, so listing them would be a no-op.
CONFIG_NF_TABLES=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
# 4.19's name for the masquerade target is the per-family IP_NF_TARGET_*
# (NETFILTER_XT_TARGET_MASQUERADE only exists on newer kernels).
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# ---- legacy compat (4.19 and older) ----------------------------------------
# NF_CONNTRACK_IPV4 / NF_CONNTRACK_IPV6 were removed in 4.19 (the generic
# NF_CONNTRACK covers both), so they are not listed.
CONFIG_NF_NAT_IPV4=y
CONFIG_IP_NF_NAT=y

# ---- Docker / container runtime extras -------------------------------------
# Kept deliberately small: these are the pieces Docker/containerd and most
# rootless runtimes expect beyond the base NAT set above. Verify with
# "droidspaces check" after flashing; remove any symbol reported as missing.
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_NAT_FTP=y
CONFIG_NF_CONNTRACK_TFTP=y
CONFIG_NF_NAT_TFTP=y

# ---- IPv6 NAT (NAT66): DISABLED on purpose --------------------------------
# The vendor VINTF matrix for this device (compatibility_matrix.6.xml, kernel
# 4.19.191) requires CONFIG_IP6_NF_NAT=n. Leaving it on makes Android show
# "There's an internal problem with your device..." at every boot. Droidspaces
# does not need IPv6 NAT (it needs IPv6 REJECT + IPv4 MASQUERADE, both kept).
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
# CONFIG_IP6_NF_NAT is not set
# CONFIG_IP6_NF_TARGET_MASQUERADE is not set

# ---- legacy compat IPv6 ----------------------------------------------------
# NF_CONNTRACK_IPV6 does not exist in 4.19 (removed upstream).
# NF_NAT_IPV6 selects IP6_NF_NAT, so it must stay off too (see above).
# CONFIG_NF_NAT_IPV6 is not set

# ---- Macvlan mode (--net=macvlan) ------------------------------------------
CONFIG_MACVLAN=y

# ---- Container networking on older kernels ---------------------------------
# NOTE: CONFIG_ANDROID_PARANOID_NETWORK does not exist in the LineageOS earth
# tree at all (it is an out-of-tree Android patch), so there is nothing to turn
# off here. The option is intentionally absent rather than set to =n.

# ---- Fix for docker "unsafe procfs" error ----------------------------------
CONFIG_USER_NS=y

# ---- FUSE / TUN: FUSE filesystems and VPNs inside containers ---------------
CONFIG_FUSE_FS=y
CONFIG_TUN=y

# ---- tmpfs: required by TMPFS_XATTR / TMPFS_POSIX_ACL below ----------------
CONFIG_TMPFS=y
# ============================================================================
#  Firewall support inside containers (UFW / Fail2Ban)
#  Optional. Keep enabled if you want UFW or Fail2Ban to work in a container.
# ============================================================================
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_HL=y
# IPv4 REJECT is IP_NF_TARGET_REJECT; NETFILTER_XT_TARGET_REJECT is 5.x-only.
CONFIG_IP_NF_TARGET_REJECT=y
# Same for IPv6 (the Droidspaces docs do not mention this one).
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
# IP_NF_TARGET_ULOG was removed in 4.19 (LOG + NFLOG cover it).
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y

# --- vendor FCM (VINTF) requirements ----------------------------------------
# Android checks the running kernel's config (/proc/config.gz) against
# /system/etc/vintf/compatibility_matrix.6.xml, section <kernel version="4.19.191">.
# ANY mismatch makes every boot show the dialog
#   "There's an internal problem with your device. Contact your manufacturer
#    for details."   (Chinese ROMs show the localized text)
# Verified against this device's matrix: exactly three entries differ from what
# the vendor expects, and all three are handled here / by setup-kernel.sh:
#   CONFIG_SYSVIPC must be n         -> the line below (AOSP's android-base.config
#                                       asks for the same; some custom kernels
#                                       ship it as y, which is why they also pop
#                                       this dialog)
#   CONFIG_IP6_NF_NAT must be n      -> handled in the IPv6 NAT section above
#   CONFIG_TRACE_GPU_MEM must be y   -> driver vendored by scripts/setup-kernel.sh
# CONFIG_SYSVIPC is not set
